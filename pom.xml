<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.engpassradar</groupId>
    <artifactId>engpass-radar</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    <name>Engpass-Radar</name>
    <description>Bedarfs- und Kapazitaetsabgleich mit Lieferantenausfall-Szenarien (Lernprojekt, fiktive Daten)</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee.version>10.0.0</jakartaee.version>
        <payara.version>6.2025.11</payara.version>
        <junit.version>5.11.4</junit.version>
        <yasson.version>3.0.4</yasson.version>
        <failOnMissingWebXml>false</failOnMissingWebXml>
        <skipPayara>false</skipPayara>
    </properties>

    <dependencies>
        <!-- Jakarta EE 10 API, zur Laufzeit von Payara bereitgestellt -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSON-B Implementierung fuer Tests und den Demo-Export (Payara bringt Yasson selbst mit) -->
        <dependency>
            <groupId>org.eclipse</groupId>
            <artifactId>yasson</artifactId>
            <version>${yasson.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>engpass-radar</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!-- Die Weboberflaeche liegt in docs/ (auch fuer GitHub Pages) und wird ins WAR kopiert -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <webResources>
                        <resource>
                            <directory>docs</directory>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>

            <!-- Laedt Payara Micro nach target/, damit run.cmd / run.sh die Anwendung starten koennen -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>payara-micro-holen</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <skip>${skipPayara}</skip>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>fish.payara.extras</groupId>
                                    <artifactId>payara-micro</artifactId>
                                    <version>${payara.version}</version>
                                    <destFileName>payara-micro.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- mvn exec:java schreibt die Szenario-Ergebnisse als JSON nach docs/data (statische Demo) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>de.engpassradar.export.DemoExport</mainClass>
                    <classpathScope>test</classpathScope>
                    <arguments>
                        <argument>docs/data</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
